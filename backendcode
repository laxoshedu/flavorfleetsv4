// ===== SUBMIT RATINGS (Shop + Items) =====
// payload: { shopEmail, orderId, customerEmail, shopRating, itemRatings: {itemId: rating} }
function submitRatings(shopEmail, orderId, customerEmail, shopRating, itemRatings) {
  try {
    initializeMainSheets_();

    const shopSsid = ensureShopSpreadsheet_(shopEmail);
    const shopSs = SpreadsheetApp.openById(shopSsid);

    const ordersSheet = shopSs.getSheetByName(ORDERS_TAB);
    ensureOrdersSheetColumns_(ordersSheet);

    // Find the order row
    const all = ordersSheet.getDataRange().getValues();
    const targetEmail = String(customerEmail).trim().toLowerCase();
    let orderRowIndex = -1;
    let orderRow = null;

    for (let i = 1; i < all.length; i++) {
      const row = all[i];
      if (String(row[0]).trim() === String(orderId).trim() &&
          String(row[1]).trim().toLowerCase() === targetEmail) {
        orderRowIndex = i + 1; // sheet row index (1-based)
        orderRow = row;
        break;
      }
    }

    if (!orderRow) return { success: false, message: 'Order not found' };

    const status = String(orderRow[9] || '');
    if (status !== 'Delivered') {
      return { success: false, message: 'You can rate only after order is Delivered' };
    }

    const existingRatingsJson = orderRow[13];
    if (existingRatingsJson && String(existingRatingsJson).trim() !== '') {
      return { success: false, message: 'Rating already submitted for this order' };
    }

    // Validate ratings
    const sr = Number(shopRating || 0);
    if (!(sr >= 1 && sr <= 5)) return { success: false, message: 'Invalid shop rating' };

    const ratingsObj = {
      shopRating: sr,
      items: {}
    };

    // Parse items from order
    let orderItems = [];
    try { orderItems = orderRow[4] ? JSON.parse(orderRow[4]) : []; } catch (e) {}

    // Update shop rating sum/count
    const shopTab = shopSs.getSheetByName(SHOP_TAB);
    const shopData = parseShopSheet_(shopTab);

    const newShopSum = Number(shopData.shopRatingSum || 0) + sr;
    const newShopCount = Number(shopData.shopRatingCount || 0) + 1;

    // Update item rating sum/count on Shop tab items table
    // We'll rebuild shop sheet preserving config/items but updating sums/counts
    const updatedItems = (shopData.items || []).map(it => {
      const rid = String(it.id);
      const given = itemRatings && Object.prototype.hasOwnProperty.call(itemRatings, rid) ? Number(itemRatings[rid]) : 0;

      if (given >= 1 && given <= 5) {
        ratingsObj.items[rid] = given;
        return {
          ...it,
          ratingSum: Number(it.ratingSum || 0) + given,
          ratingCount: Number(it.ratingCount || 0) + 1
        };
      }
      return it;
    });

    // Ensure user rated at least one item too (optional requirement: you asked per item, but to keep flexible we allow partial)
    // If you want to force all items, validate here.

    writeShopSheet_(shopTab, {
      shopName: shopData.name,
      managerName: shopData.managerName,
      contactNumber: shopData.contactNumber,
      email: shopData.email,
      logo: shopData.logo,
      heroTitle: shopData.heroTitle,
      heroSubtitle: shopData.heroSubtitle,
      heroBackground: shopData.heroBackground,
      shopRatingSum: newShopSum,
      shopRatingCount: newShopCount
    }, updatedItems);

    // Save ratings into Orders sheet (Ratings Json col14, Rating Time col15)
    const ratingTime = new Date();
    ordersSheet.getRange(orderRowIndex, 14).setValue(JSON.stringify(ratingsObj));
    ordersSheet.getRange(orderRowIndex, 15).setValue(ratingTime);

    // Also store into customer's tab row (if exists)
    const idx = shopSs.getSheetByName(CUSTOMERS_INDEX_TAB);
    const idxValues = idx.getDataRange().getValues();
    let customerTab = null;
    for (let j = 1; j < idxValues.length; j++) {
      if (String(idxValues[j][0]).trim().toLowerCase() === targetEmail) {
        customerTab = String(idxValues[j][1]).trim();
        break;
      }
    }
    if (customerTab && shopSs.getSheetByName(customerTab)) {
      const custSheet = shopSs.getSheetByName(customerTab);
      ensureCustomerOrderSheetColumns_(custSheet);
      const custAll = custSheet.getDataRange().getValues();
      for (let r = 1; r < custAll.length; r++) {
        if (String(custAll[r][0]).trim() === String(orderId).trim()) {
          // Ratings Json col12, Rating Time col13
          custSheet.getRange(r + 1, 12).setValue(JSON.stringify(ratingsObj));
          custSheet.getRange(r + 1, 13).setValue(ratingTime);
          break;
        }
      }
    }

    return { success: true, message: 'Ratings saved successfully' };
  } catch (error) {
    Logger.log('Error in submitRatings: ' + error);
    return { success: false, message: String(error) };
  }
}

// ===== DO_POST =====
function doPost(e) {
  try {
    const data = JSON.parse(e.postData.contents);
    const action = data.action;
    let result;

    switch (action) {
      case 'customerSignup':
        result = customerSignup(data.data);
        break;
      case 'createShop':
        result = createShop(data.data);
        break;
      case 'generateOTP':
        result = generateOTP(data.email, data.type);
        break;
      case 'verifyOTP':
        result = verifyOTP(data.email, data.otp, data.type);
        break;
      case 'getAllShopsWithItems':
        result = getAllShopsWithItems();
        break;
      case 'getShopData':
        result = getShopData(data.email);
        break;
      case 'saveShopData':
        result = saveShopData(data.email, data.data);
        break;
      case 'saveOrder':
        result = saveOrder(data.order);
        break;

      // Now returns LAST 1 YEAR by default, but still uses the same action name for compatibility
      case 'getTodaysOrders':
        result = getShopOrders(data.shopEmail, data.startDate || '', data.endDate || '');
        break;

      case 'getCustomerOrders':
        result = getCustomerOrders(data.customerEmail);
        break;
      case 'confirmOrder':
        result = confirmOrder(data.orderId, data.customerEmail, data.note, data.shopEmail);
        break;
      case 'rejectOrder':
        result = rejectOrder(data.orderId, data.customerEmail, data.note, data.shopEmail);
        break;
      case 'markDelivered':
        result = markDelivered(data.orderId, data.customerEmail, data.note, data.shopEmail);
        break;

      case 'submitRatings':
        result = submitRatings(
          data.shopEmail,
          data.orderId,
          data.customerEmail,
          data.shopRating,
          data.itemRatings || {}
        );
        break;

      default:
        result = { success: false, message: 'Invalid action' };
    }

    return ContentService
      .createTextOutput(JSON.stringify(result))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (error) {
    Logger.log('Error in doPost: ' + error);
    return ContentService
      .createTextOutput(JSON.stringify({ success: false, message: String(error) }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

