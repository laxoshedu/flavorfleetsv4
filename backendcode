// ===== GET SHOP ORDERS (LAST 1 YEAR) + OPTIONAL DATE FILTER =====
// NOTE: frontend still calls action "getTodaysOrders"; we keep that action but now it returns last 1 year.
// If you pass startDate/endDate in payload, it will filter by that range.
function getShopOrders(shopEmail, startDate, endDate) {
  try {
    initializeMainSheets_();
    const shopSsid = ensureShopSpreadsheet_(shopEmail);
    const shopSs = SpreadsheetApp.openById(shopSsid);

    const ordersSheet = shopSs.getSheetByName(ORDERS_TAB);
    ensureOrdersSheetColumns_(ordersSheet);
    pruneOrdersOlderThanOneYear_(ordersSheet);

    const all = ordersSheet.getDataRange().getValues();
    if (all.length <= 1) return { success: true, orders: [] };

    const cutoff = new Date();
    cutoff.setDate(cutoff.getDate() - ORDER_RETENTION_DAYS);

    let from = startDate ? new Date(startDate) : null;
    let to = endDate ? new Date(endDate) : null;
    if (from && !isNaN(from.getTime())) from.setHours(0, 0, 0, 0); else from = null;
    if (to && !isNaN(to.getTime())) to.setHours(23, 59, 59, 999); else to = null;

    const orders = [];

    for (let i = 1; i < all.length; i++) {
      const row = all[i];
      if (!row[0]) continue;

      const orderTime = row[11];
      const dt = new Date(orderTime);
      if (!isNaN(dt.getTime()) && dt < cutoff) continue;

      if (from && dt < from) continue;
      if (to && dt > to) continue;

      let items = [];
      try { items = row[4] ? JSON.parse(row[4]) : []; } catch (e) {}

      const ratingsJson = row[13] || '';
      let parsedRatings = null;
      try { parsedRatings = ratingsJson ? JSON.parse(ratingsJson) : null; } catch (e) {}

      orders.push({
        orderId: row[0],
        customerEmail: row[1],
        customerName: row[2],
        customerPhone: row[3],
        items: items,
        total: row[5],
        address: row[6],
        transactionId: row[7],
        paymentScreenshot: row[8],
        status: row[9],
        note: row[10],
        orderTime: row[11],
        updatedTime: row[12],
        ratings: parsedRatings,
        ratingTime: row[14] || ''
      });
    }

    // newest first
    orders.sort((a, b) => new Date(b.orderTime).getTime() - new Date(a.orderTime).getTime());

    return { success: true, orders: orders };
  } catch (error) {
    Logger.log('Error in getShopOrders: ' + error);
    return { success: false, orders: [], message: String(error) };
  }
}

// ===== GET CUSTOMER ORDERS (LAST 1 YEAR) =====
function getCustomerOrders(customerEmail) {
  try {
    initializeMainSheets_();
    const ss = getMainSpreadsheet_();
    const shopsSheet = ss.getSheetByName(MASTER_SHOPS_SHEET);
    const shops = shopsSheet.getDataRange().getValues();

    const cutoff = new Date();
    cutoff.setDate(cutoff.getDate() - ORDER_RETENTION_DAYS);

    const orders = [];
    const target = String(customerEmail).trim().toLowerCase();

    for (let i = 1; i < shops.length; i++) {
      if (shops[i][0] !== 'Shop') continue;

      const shopEmail = shops[i][1];
      const shopSsid = ensureShopSpreadsheet_(shopEmail);
      const shopSs = SpreadsheetApp.openById(shopSsid);

      const ordersSheet = shopSs.getSheetByName(ORDERS_TAB);
      ensureOrdersSheetColumns_(ordersSheet);
      pruneOrdersOlderThanOneYear_(ordersSheet);

      const all = ordersSheet.getDataRange().getValues();
      for (let r = 1; r < all.length; r++) {
        const row = all[r];
        if (!row[0]) continue;

        const rowEmail = String(row[1]).trim().toLowerCase();
        if (rowEmail !== target) continue;

        const orderTime = row[11];
        const dt = new Date(orderTime);
        if (!isNaN(dt.getTime()) && dt < cutoff) continue;

        let items = [];
        try { items = row[4] ? JSON.parse(row[4]) : []; } catch (e) {}

        const ratingsJson = row[13] || '';
        let parsedRatings = null;
        try { parsedRatings = ratingsJson ? JSON.parse(ratingsJson) : null; } catch (e) {}

        orders.push({
          shopEmail: shopEmail,
          orderId: row[0],
          items: items,
          total: row[5],
          address: row[6],
          transactionId: row[7],
          paymentScreenshot: row[8],
          status: row[9],
          note: row[10],
          orderTime: row[11],
          updatedTime: row[12],
          ratings: parsedRatings,
          ratingTime: row[14] || '',
          customerName: row[2]
        });
      }
    }

    orders.sort((a, b) => new Date(b.orderTime).getTime() - new Date(a.orderTime).getTime());
    return { success: true, orders: orders };
  } catch (error) {
    Logger.log('Error in getCustomerOrders: ' + error);
    return { success: false, orders: [], message: String(error) };
  }
}

// ===== UPDATE ORDER STATUS (confirm/reject/deliver) =====
function updateOrderStatus_(shopEmail, orderId, customerEmail, status, note) {
  const shopSsid = ensureShopSpreadsheet_(shopEmail);
  const shopSs = SpreadsheetApp.openById(shopSsid);

  const ordersSheet = shopSs.getSheetByName(ORDERS_TAB);
  ensureOrdersSheetColumns_(ordersSheet);

  const all = ordersSheet.getDataRange().getValues();
  const targetEmail = String(customerEmail).trim().toLowerCase();

  for (let i = 1; i < all.length; i++) {
    const row = all[i];
    if (String(row[0]).trim() === String(orderId).trim() &&
        String(row[1]).trim().toLowerCase() === targetEmail) {

      // Status col 10, Note col 11, Updated Time col 13
      ordersSheet.getRange(i + 1, 10).setValue(status);
      ordersSheet.getRange(i + 1, 11).setValue(note || '');
      ordersSheet.getRange(i + 1, 13).setValue(new Date());

      // Update customer's tab row (inside this shop spreadsheet)
      const idx = shopSs.getSheetByName(CUSTOMERS_INDEX_TAB);
      const idxValues = idx.getDataRange().getValues();
      let customerTab = null;
      for (let j = 1; j < idxValues.length; j++) {
        if (String(idxValues[j][0]).trim().toLowerCase() === targetEmail) {
          customerTab = String(idxValues[j][1]).trim();
          break;
        }
      }
      if (customerTab && shopSs.getSheetByName(customerTab)) {
        const custSheet = shopSs.getSheetByName(customerTab);
        ensureCustomerOrderSheetColumns_(custSheet);
        const custAll = custSheet.getDataRange().getValues();
        for (let r = 1; r < custAll.length; r++) {
          if (String(custAll[r][0]).trim() === String(orderId).trim()) {
            // Status col 8, Note col 9, Updated col 11
            custSheet.getRange(r + 1, 8).setValue(status);
            custSheet.getRange(r + 1, 9).setValue(note || '');
            custSheet.getRange(r + 1, 11).setValue(new Date());
            break;
          }
        }
      }

      // Notify customer
      try {
        let subject = '';
        let body = '';
        if (status === 'Confirmed') {
          subject = 'Your Order Confirmed - FlavorFleet';
          body = `<h2 style="color:#28a745;">Your order has been confirmed!</h2>
                  <p><strong>Order ID:</strong> ${orderId}</p>
                  <p>Your food is being prepared and will be delivered soon.</p>
                  ${note ? `<p><strong>Note from shop:</strong> ${note}</p>` : ''}
                  <hr><p><small>© 2024 FlavorFleet</small></p>`;
        } else if (status === 'Rejected') {
          subject = 'Your Order Rejected - FlavorFleet';
          body = `<h2 style="color:#dc3545;">Your order has been rejected.</h2>
                  <p><strong>Order ID:</strong> ${orderId}</p>
                  ${note ? `<p><strong>Reason / Note:</strong> ${note}</p>` : ''}
                  <hr><p><small>© 2024 FlavorFleet</small></p>`;
        } else if (status === 'Delivered') {
          subject = 'Order Delivered - FlavorFleet';
          body = `<h2 style="color:#28a745;">Delivered successfully!</h2>
                  <p><strong>Order ID:</strong> ${orderId}</p>
                  ${note ? `<p><strong>Note:</strong> ${note}</p>` : ''}
                  <p>Thank you for ordering with FlavorFleet.</p>
                  <hr><p><small>© 2024 FlavorFleet</small></p>`;
        }
        if (subject) MailApp.sendEmail(customerEmail, subject, '', { htmlBody: body });
      } catch (e) {}

      return true;
    }
  }
  return false;
}

