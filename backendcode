// ===== GLOBAL CONFIG =====
const OTP_VALIDITY = 120000; // 2 minutes
const MAX_OTP_ATTEMPTS = 5;
const OTP_COOLDOWN = 300000; // 5 minutes

// Main controller spreadsheet tabs (in the *main* FlavorFleet spreadsheet)
const OTP_SHEET = 'OTP_Management';
const MASTER_CUSTOMERS_SHEET = 'Master_Customers';
const MASTER_SHOPS_SHEET = 'Master_Shops';

// Per-shop spreadsheet tabs (each shop has its own spreadsheet)
const SHOP_TAB = 'Shop'; // config + items
const ORDERS_TAB = 'Orders';
const CUSTOMERS_INDEX_TAB = 'Customers_Index';

// Order retention
const ORDER_RETENTION_DAYS = 365;

// Drive folder for payment screenshots
const PAYMENTS_FOLDER_NAME = 'FlavorFleet_Payments';

// ScriptProperties key prefix for mapping shopEmail -> shopSpreadsheetId
const SHOP_SSID_PREFIX = 'SHOP_SSID_';

// ===== INITIALIZE MAIN SHEETS =====
function initializeMainSheets_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  // OTP_Management
  if (!ss.getSheetByName(OTP_SHEET)) {
    const otpSheet = ss.insertSheet(OTP_SHEET);
    otpSheet.appendRow(['Email', 'Type', 'OTP', 'Generated Time', 'Attempts', 'Status', 'Last OTP Request', 'Verified Date']);
  }

  // Master_Customers
  if (!ss.getSheetByName(MASTER_CUSTOMERS_SHEET)) {
    const sh = ss.insertSheet(MASTER_CUSTOMERS_SHEET);
    sh.appendRow(['Type', 'Email', 'Name', 'Phone', 'Created Date', 'Updated Date']);
  }

  // Master_Shops
  if (!ss.getSheetByName(MASTER_SHOPS_SHEET)) {
    const sh = ss.insertSheet(MASTER_SHOPS_SHEET);
    sh.appendRow(['Type', 'Email', 'Name', 'Phone', 'Created Date', 'Updated Date']);
  }
}

// ===== HELPERS =====
function sanitizeSheetName(name) {
  return String(name || '')
    .substring(0, 31)
    .replace(/[^a-zA-Z0-9_]/g, '_')
    .replace(/_+/g, '_')
    .replace(/^_|_$/g, '');
}

function getMainSpreadsheet_() {
  return SpreadsheetApp.getActiveSpreadsheet();
}

function findRowByEmail_(sheet, email, emailColIndex1based) {
  const values = sheet.getDataRange().getValues();
  const target = String(email).trim().toLowerCase();
  for (let i = 1; i < values.length; i++) {
    if (String(values[i][emailColIndex1based - 1]).trim().toLowerCase() === target) {
      return { rowIndex: i + 1, row: values[i] };
    }
  }
  return null;
}

function scriptProps_() {
  return PropertiesService.getScriptProperties();
}

function getShopSpreadsheetId_(shopEmail) {
  const key = SHOP_SSID_PREFIX + String(shopEmail).trim().toLowerCase();
  return scriptProps_().getProperty(key) || '';
}

function setShopSpreadsheetId_(shopEmail, ssid) {
  const key = SHOP_SSID_PREFIX + String(shopEmail).trim().toLowerCase();
  scriptProps_().setProperty(key, String(ssid));
}

function getOrCreateFolder_(parentFolder, name) {
  const iter = parentFolder.getFoldersByName(name);
  if (iter.hasNext()) return iter.next();
  return parentFolder.createFolder(name);
}

function getPaymentsFolderForShop_(shopEmail) {
  const root = DriveApp.getRootFolder();
  const mainFolder = getOrCreateFolder_(root, PAYMENTS_FOLDER_NAME);
  const safe = sanitizeSheetName(shopEmail);
  return getOrCreateFolder_(mainFolder, safe || 'shop');
}

function getFileExtensionFromMime_(mime) {
  const map = {
    'image/png': 'png',
    'image/jpeg': 'jpg',
    'image/jpg': 'jpg',
    'image/webp': 'webp'
  };
  return map[mime] || 'png';
}

function uploadPaymentScreenshot_(paymentScreenshot, orderId, shopEmail, customerEmail) {
  try {
    if (!paymentScreenshot || paymentScreenshot === 'Not provided') return '';
    if (typeof paymentScreenshot !== 'string') return '';

    // already a URL
    if (paymentScreenshot.startsWith('http://') || paymentScreenshot.startsWith('https://')) {
      return paymentScreenshot;
    }

    // data URI
    if (paymentScreenshot.startsWith('data:image/')) {
      const comma = paymentScreenshot.indexOf(',');
      const meta = paymentScreenshot.substring(0, comma);
      const b64 = paymentScreenshot.substring(comma + 1);

      const mimeMatch = meta.match(/data:(image\/[a-zA-Z0-9.+-]+);base64/);
      const mime = mimeMatch ? mimeMatch[1] : 'image/png';
      const ext = getFileExtensionFromMime_(mime);

      const bytes = Utilities.base64Decode(b64);
      const blob = Utilities.newBlob(bytes, mime, `${orderId}.${ext}`);

      const folder = getPaymentsFolderForShop_(shopEmail);
      const safeEmail = sanitizeSheetName(customerEmail);
      const file = folder.createFile(blob);
      file.setName(`${orderId}_${safeEmail || 'customer'}.${ext}`);

      file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
      return file.getUrl();
    }

    return '';
  } catch (err) {
    Logger.log('uploadPaymentScreenshot_ error: ' + err);
    return '';
  }
}

function ensureOrdersSheetColumns_(ordersSheet) {
  // Required columns (in order)
  const required = [
    'Order ID', 'Customer Email', 'Customer Name', 'Customer Phone',
    'Items', 'Total', 'Address', 'Transaction ID', 'Payment Screenshot',
    'Status', 'Note', 'Order Time', 'Updated Time',
    'Ratings Json', 'Rating Time'
  ];

  const lastCol = ordersSheet.getLastColumn() || 1;
  const header = ordersSheet.getRange(1, 1, 1, lastCol).getValues()[0].map(String);

  // if empty header, create
  if (ordersSheet.getLastRow() === 0) {
    ordersSheet.appendRow(required);
    return;
  }

  // Add missing columns at the end
  let current = header.slice();
  required.forEach(col => {
    if (!current.includes(col)) {
      ordersSheet.insertColumnAfter(ordersSheet.getLastColumn());
      ordersSheet.getRange(1, ordersSheet.getLastColumn()).setValue(col);
      current.push(col);
    }
  });
}

function ensureCustomerOrderSheetColumns_(sheet) {
  const required = [
    'Order ID', 'Shop Email', 'Items', 'Total',
    'Address', 'Transaction ID', 'Payment Screenshot',
    'Status', 'Note', 'Order Time', 'Updated Time',
    'Ratings Json', 'Rating Time'
  ];

  const lastCol = sheet.getLastColumn() || 1;
  const header = sheet.getRange(1, 1, 1, lastCol).getValues()[0].map(String);
  if (sheet.getLastRow() === 0) {
    sheet.appendRow(required);
    return;
  }
  let current = header.slice();
  required.forEach(col => {
    if (!current.includes(col)) {
      sheet.insertColumnAfter(sheet.getLastColumn());
      sheet.getRange(1, sheet.getLastColumn()).setValue(col);
      current.push(col);
    }
  });
}

// ===== SHOP SHEET (Shop tab) PARSE/WRITE =====
function parseShopSheet_(sheet) {
  const data = sheet.getDataRange().getValues();
  const shopData = {
    name: '',
    logo: '',
    heroTitle: '',
    heroSubtitle: '',
    heroBackground: '',
    managerName: '',
    contactNumber: '',
    email: '',
    shopRatingSum: 0,
    shopRatingCount: 0,
    items: []
  };

  // read config
  for (let i = 1; i < data.length; i++) {
    if (data[i][0] === 'Config') {
      const key = String(data[i][1] || '').trim();
      const value = data[i][2];
      if (key === 'shopName') shopData.name = value;
      else if (key === 'logo') shopData.logo = value;
      else if (key === 'heroTitle') shopData.heroTitle = value;
      else if (key === 'heroSubtitle') shopData.heroSubtitle = value;
      else if (key === 'heroBackground') shopData.heroBackground = value;
      else if (key === 'managerName') shopData.managerName = value;
      else if (key === 'contactNumber') shopData.contactNumber = value;
      else if (key === 'email') shopData.email = value;
      else if (key === 'shopRatingSum') shopData.shopRatingSum = Number(value || 0);
      else if (key === 'shopRatingCount') shopData.shopRatingCount = Number(value || 0);
    }
  }

  // find item header row
  let itemStartIndex = -1;
  for (let i = 0; i < data.length; i++) {
    if (String(data[i][0]).trim() === 'ItemName') {
      itemStartIndex = i;
      break;
    }
  }

  // Items row structure:
  // [ItemName, ItemPrice, ItemDescription, ItemImage, ItemId, RatingSum, RatingCount]
  if (itemStartIndex !== -1) {
    for (let i = itemStartIndex + 1; i < data.length; i++) {
      if (!data[i][0] || String(data[i][0]).trim() === '') break;

      // stop if another section begins (not expected in new shop sheets, but safe)
      if (String(data[i][0]).trim() === 'Order ID') break;

      const ratingSum = Number(data[i][5] || 0);
      const ratingCount = Number(data[i][6] || 0);
      const avg = ratingCount > 0 ? (ratingSum / ratingCount) : 0;

      const item = {
        name: data[i][0],
        price: parseFloat(data[i][1]),
        description: data[i][2],
        image: data[i][3],
        id: data[i][4] || String(Date.now()),
        ratingSum: ratingSum,
        ratingCount: ratingCount,
        ratingAvg: avg
      };

      if (item.name && !isNaN(item.price)) shopData.items.push(item);
    }
  }

  return shopData;
}

function writeShopSheet_(sheet, config, items) {
  const lastRow = sheet.getLastRow();
  if (lastRow > 0) sheet.deleteRows(1, lastRow);

  sheet.appendRow(['Type', 'Key', 'Value']);
  sheet.appendRow(['Config', 'shopName', config.shopName]);
  sheet.appendRow(['Config', 'managerName', config.managerName]);
  sheet.appendRow(['Config', 'contactNumber', config.contactNumber]);
  sheet.appendRow(['Config', 'email', config.email]);
  sheet.appendRow(['Config', 'logo', config.logo]);
  sheet.appendRow(['Config', 'heroTitle', config.heroTitle]);
  sheet.appendRow(['Config', 'heroSubtitle', config.heroSubtitle]);
  sheet.appendRow(['Config', 'heroBackground', config.heroBackground]);
  sheet.appendRow(['Config', 'shopRatingSum', Number(config.shopRatingSum || 0)]);
  sheet.appendRow(['Config', 'shopRatingCount', Number(config.shopRatingCount || 0)]);

  sheet.appendRow(['ItemName', 'ItemPrice', 'ItemDescription', 'ItemImage', 'ItemId', 'RatingSum', 'RatingCount']);
  (items || []).forEach(it => {
    sheet.appendRow([
      it.name,
      it.price,
      it.description,
      it.image,
      it.id,
      Number(it.ratingSum || 0),
      Number(it.ratingCount || 0)
    ]);
  });
}

