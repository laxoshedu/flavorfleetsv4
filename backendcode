// ===== SHOP SPREADSHEET ENSURE =====
function ensureShopSpreadsheet_(shopEmail) {
  initializeMainSheets_();
  const ss = getMainSpreadsheet_();
  const shopsSheet = ss.getSheetByName(MASTER_SHOPS_SHEET);

  const found = findRowByEmail_(shopsSheet, shopEmail, 2);
  if (!found) throw new Error('Shop not found');

  const ssid = getShopSpreadsheetId_(shopEmail);
  if (ssid) return ssid;

  // If missing mapping, create fresh shop spreadsheet (or you can add migration logic here if needed)
  const shopName = found.row[2];
  const contactNumber = found.row[3];

  // managerName isn't in Master_Shops by requirement, so store it in shop config as shopName by default
  const newId = createShopSpreadsheet_({
    shopName,
    managerName: shopName,
    contactNumber,
    email: shopEmail
  });

  setShopSpreadsheetId_(shopEmail, newId);
  return newId;
}

// ===== ORDER CLEANUP (1 year) =====
function pruneOrdersOlderThanOneYear_(ordersSheet) {
  const lastRow = ordersSheet.getLastRow();
  if (lastRow <= 1) return;

  ensureOrdersSheetColumns_(ordersSheet);

  const values = ordersSheet.getRange(2, 1, lastRow - 1, ordersSheet.getLastColumn()).getValues();
  const cutoff = new Date();
  cutoff.setDate(cutoff.getDate() - ORDER_RETENTION_DAYS);

  // Order Time column name "Order Time"
  // In our schema it's column 12 (index 11)
  const orderTimeIdx0 = 11;

  for (let i = values.length - 1; i >= 0; i--) {
    const orderTime = values[i][orderTimeIdx0];
    if (!orderTime) continue;
    const d = new Date(orderTime);
    if (!isNaN(d.getTime()) && d < cutoff) {
      ordersSheet.deleteRow(i + 2);
    }
  }
}

// ===== CUSTOMER SIGNUP =====
function customerSignup(data) {
  try {
    initializeMainSheets_();
    const ss = getMainSpreadsheet_();
    const sheet = ss.getSheetByName(MASTER_CUSTOMERS_SHEET);

    const existing = findRowByEmail_(sheet, data.email, 2);
    if (existing) return { success: false, message: 'Email already registered' };

    sheet.appendRow(['Customer', data.email, data.username, data.phone, new Date(), new Date()]);
    return { success: true, message: 'Customer registered successfully' };
  } catch (error) {
    Logger.log('Error in customerSignup: ' + error);
    return { success: false, message: String(error) };
  }
}

// ===== CREATE SHOP =====
function createShop(data) {
  try {
    initializeMainSheets_();
    const ss = getMainSpreadsheet_();
    const shopsSheet = ss.getSheetByName(MASTER_SHOPS_SHEET);

    const existing = findRowByEmail_(shopsSheet, data.email, 2);
    if (existing) return { success: false, message: 'Shop already exists with this email' };

    // Create separate spreadsheet for shop
    const shopSpreadsheetId = createShopSpreadsheet_(data);
    setShopSpreadsheetId_(data.email, shopSpreadsheetId);

    shopsSheet.appendRow(['Shop', data.email, data.shopName, data.contactNumber, new Date(), new Date()]);
    return { success: true, message: 'Shop created successfully' };
  } catch (error) {
    Logger.log('Error in createShop: ' + error);
    return { success: false, message: String(error) };
  }
}

// ===== GENERATE OTP =====
function generateOTP(email, type) {
  try {
    initializeMainSheets_();
    const ss = getMainSpreadsheet_();
    const otpSheet = ss.getSheetByName(OTP_SHEET);

    let userData = null;

    if (type === 'customer') {
      const custSheet = ss.getSheetByName(MASTER_CUSTOMERS_SHEET);
      const found = findRowByEmail_(custSheet, email, 2);
      if (!found) return { success: false, message: 'User not found' };
      const row = found.row;
      userData = { type: 'Customer', username: row[2], email: row[1], phone: row[3] };
    } else {
      const shopsSheet = ss.getSheetByName(MASTER_SHOPS_SHEET);
      const found = findRowByEmail_(shopsSheet, email, 2);
      if (!found) return { success: false, message: 'User not found' };

      const shopSsid = ensureShopSpreadsheet_(email);
      const shopSs = SpreadsheetApp.openById(shopSsid);
      const parsed = parseShopSheet_(shopSs.getSheetByName(SHOP_TAB));

      userData = {
        type: 'Shop',
        shopName: parsed.name,
        managerName: parsed.managerName,
        contactNumber: parsed.contactNumber
      };
    }

    // cooldown/attempts
    const otpValues = otpSheet.getDataRange().getValues();
    const now = new Date().getTime();
    let otpRowIndex = -1;
    let todayAttempts = 0;

    for (let i = 1; i < otpValues.length; i++) {
      if (String(otpValues[i][0]).trim().toLowerCase() === String(email).trim().toLowerCase() &&
          String(otpValues[i][1]).trim().toLowerCase() === String(type).trim().toLowerCase()) {

        otpRowIndex = i;
        const lastRequestTime = otpValues[i][6] ? new Date(otpValues[i][6]).getTime() : 0;
        if (lastRequestTime && now - lastRequestTime < OTP_COOLDOWN) {
          return { success: false, message: 'Please wait before requesting another OTP' };
        }

        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const generatedDate = otpValues[i][3] ? new Date(otpValues[i][3]) : null;
        if (generatedDate) {
          generatedDate.setHours(0, 0, 0, 0);
          if (generatedDate.getTime() === today.getTime()) {
            todayAttempts = parseInt(otpValues[i][4], 10) || 0;
          }
        }
        break;
      }
    }

    if (todayAttempts >= MAX_OTP_ATTEMPTS) {
      return { success: false, message: `Maximum OTP requests (${MAX_OTP_ATTEMPTS}) exceeded for today` };
    }

    const otp = Math.floor(100000 + Math.random() * 900000).toString();
    const generatedTime = new Date();

    if (otpRowIndex !== -1) {
      otpSheet.getRange(otpRowIndex + 1, 3).setValue(otp);
      otpSheet.getRange(otpRowIndex + 1, 4).setValue(generatedTime);
      otpSheet.getRange(otpRowIndex + 1, 5).setValue(todayAttempts + 1);
      otpSheet.getRange(otpRowIndex + 1, 6).setValue('Active');
      otpSheet.getRange(otpRowIndex + 1, 7).setValue(generatedTime);
    } else {
      otpSheet.appendRow([email, type, otp, generatedTime, 1, 'Active', generatedTime, '']);
    }

    const subject = 'FlavorFleet - Your OTP';
    const body = `<h2 style="color: #e53935;">Welcome to FlavorFleet!</h2>
      <p>Your OTP is: <strong style="font-size: 24px; color: #e53935;">${otp}</strong></p>
      <p>This OTP is valid for 2 minutes (120 seconds).</p>
      <p style="color: red; font-weight: bold;">Do not share this OTP with anyone.</p>
      <p>If you didn't request this OTP, please ignore this email.</p>
      <hr><p><small>© 2024 FlavorFleet. All rights reserved.</small></p>`;

    try { MailApp.sendEmail(email, subject, '', { htmlBody: body }); } catch (e) {}

    return { success: true, message: 'OTP sent to your email', userData: userData };
  } catch (error) {
    Logger.log('Error in generateOTP: ' + error);
    return { success: false, message: String(error) };
  }
}

// ===== VERIFY OTP =====
function verifyOTP(email, otp, type) {
  try {
    initializeMainSheets_();
    const ss = getMainSpreadsheet_();
    const otpSheet = ss.getSheetByName(OTP_SHEET);

    const otpValues = otpSheet.getDataRange().getValues();
    let otpRowIndex = -1;
    let storedOtp = null;
    let generatedTime = null;
    let otpStatus = null;

    for (let i = 1; i < otpValues.length; i++) {
      const sheetEmail = String(otpValues[i][0]).trim().toLowerCase();
      const sheetType = String(otpValues[i][1]).trim().toLowerCase();
      if (sheetEmail === String(email).trim().toLowerCase() && sheetType === String(type).trim().toLowerCase()) {
        otpRowIndex = i;
        storedOtp = String(otpValues[i][2]).trim();
        generatedTime = otpValues[i][3] ? new Date(otpValues[i][3]).getTime() : 0;
        otpStatus = String(otpValues[i][5]).trim();
        break;
      }
    }

    if (otpRowIndex === -1) return { success: false, message: 'OTP not found. Please request a new one.' };
    if (otpStatus === 'Verified') return { success: false, message: 'OTP already verified. Please request a new one.' };

    const now = new Date().getTime();
    if (!generatedTime || now - generatedTime > OTP_VALIDITY) {
      otpSheet.getRange(otpRowIndex + 1, 6).setValue('Expired');
      return { success: false, message: 'OTP has expired. Please request a new one.' };
    }

    if (String(storedOtp) !== String(otp).trim()) {
      return { success: false, message: 'Invalid OTP. Please try again.' };
    }

    otpSheet.getRange(otpRowIndex + 1, 6).setValue('Verified');
    otpSheet.getRange(otpRowIndex + 1, 8).setValue(new Date());

    if (type === 'customer') {
      const custSheet = ss.getSheetByName(MASTER_CUSTOMERS_SHEET);
      const found = findRowByEmail_(custSheet, email, 2);
      if (!found) return { success: false, message: 'Customer not found' };
      const row = found.row;
      return { success: true, message: 'OTP verified successfully', username: row[2], email: row[1], phone: row[3] };
    }

    const shopSsid = ensureShopSpreadsheet_(email);
    const shopSs = SpreadsheetApp.openById(shopSsid);
    const parsed = parseShopSheet_(shopSs.getSheetByName(SHOP_TAB));

    return {
      success: true,
      message: 'OTP verified successfully',
      shopName: parsed.name,
      managerName: parsed.managerName,
      contactNumber: parsed.contactNumber
    };

  } catch (error) {
    Logger.log('Error in verifyOTP: ' + error);
    return { success: false, message: String(error) };
  }
}

// ===== GET ALL SHOPS WITH ITEMS + RATINGS =====
function getAllShopsWithItems() {
  try {
    initializeMainSheets_();
    const ss = getMainSpreadsheet_();
    const shopsSheet = ss.getSheetByName(MASTER_SHOPS_SHEET);
    const values = shopsSheet.getDataRange().getValues();

    const shops = [];
    for (let i = 1; i < values.length; i++) {
      if (values[i][0] !== 'Shop') continue;

      const shopEmail = values[i][1];
      const shopSsid = ensureShopSpreadsheet_(shopEmail);
      const shopSs = SpreadsheetApp.openById(shopSsid);
      const parsed = parseShopSheet_(shopSs.getSheetByName(SHOP_TAB));

      const shopAvg = parsed.shopRatingCount > 0 ? (parsed.shopRatingSum / parsed.shopRatingCount) : 0;

      shops.push({
        shopName: parsed.name,
        shopEmail: shopEmail,
        managerName: parsed.managerName || '',
        logo: parsed.logo,
        shopRatingAvg: shopAvg,
        shopRatingCount: parsed.shopRatingCount || 0,
        items: (parsed.items || []).map(it => ({
          id: it.id,
          name: it.name,
          price: it.price,
          description: it.description,
          image: it.image,
          ratingAvg: it.ratingAvg || 0,
          ratingCount: it.ratingCount || 0
        }))
      });
    }

    // Sort shops by rating (top rated first)
    shops.sort((a, b) => {
      const ar = a.shopRatingAvg || 0, br = b.shopRatingAvg || 0;
      const ac = a.shopRatingCount || 0, bc = b.shopRatingCount || 0;
      if (br !== ar) return br - ar;
      return bc - ac;
    });

    // Also sort items inside each shop by rating
    shops.forEach(s => {
      (s.items || []).sort((a, b) => {
        const ar = a.ratingAvg || 0, br = b.ratingAvg || 0;
        const ac = a.ratingCount || 0, bc = b.ratingCount || 0;
        if (br !== ar) return br - ar;
        return bc - ac;
      });
    });

    return { success: true, shops: shops };
  } catch (error) {
    Logger.log('Error in getAllShopsWithItems: ' + error);
    return { success: false, message: String(error), shops: [] };
  }
}

