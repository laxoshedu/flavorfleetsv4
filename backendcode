// ===== SAVE SHOP DATA (preserve ratings by itemId) =====
function saveShopData(email, data) {
  try {
    initializeMainSheets_();
    const shopSsid = ensureShopSpreadsheet_(email);
    const shopSs = SpreadsheetApp.openById(shopSsid);
    const shopTab = shopSs.getSheetByName(SHOP_TAB);

    const existing = parseShopSheet_(shopTab);

    // Preserve item ratingSum/ratingCount by matching item.id
    const existingRatingMap = {};
    (existing.items || []).forEach(it => {
      existingRatingMap[String(it.id)] = { ratingSum: Number(it.ratingSum || 0), ratingCount: Number(it.ratingCount || 0) };
    });

    const mergedItems = (data.items || []).map(it => {
      const saved = existingRatingMap[String(it.id)] || { ratingSum: 0, ratingCount: 0 };
      return {
        id: it.id,
        name: it.name,
        price: it.price,
        description: it.description,
        image: it.image,
        ratingSum: saved.ratingSum,
        ratingCount: saved.ratingCount
      };
    });

    const newConfig = {
      shopName: data.name,
      managerName: existing.managerName || data.name,
      contactNumber: existing.contactNumber || '',
      email: email,
      logo: data.logo || existing.logo || '',
      heroTitle: data.heroTitle || existing.heroTitle || '',
      heroSubtitle: data.heroSubtitle || existing.heroSubtitle || '',
      heroBackground: data.heroBackground || existing.heroBackground || '',
      shopRatingSum: Number(existing.shopRatingSum || 0),
      shopRatingCount: Number(existing.shopRatingCount || 0)
    };

    writeShopSheet_(shopTab, newConfig, mergedItems);

    // update Master_Shops updated date + name
    const main = getMainSpreadsheet_();
    const shopsSheet = main.getSheetByName(MASTER_SHOPS_SHEET);
    const found = findRowByEmail_(shopsSheet, email, 2);
    if (found) {
      shopsSheet.getRange(found.rowIndex, 3).setValue(data.name);
      shopsSheet.getRange(found.rowIndex, 6).setValue(new Date());
    }

    return { success: true, message: 'Shop saved successfully' };
  } catch (error) {
    Logger.log('Error in saveShopData: ' + error);
    return { success: false, message: String(error) };
  }
}

// ===== CUSTOMER TAB CREATION INSIDE SHOP SPREADSHEET =====
function getOrCreateCustomerTab_(shopSs, customerEmail, customerName) {
  const idx = shopSs.getSheetByName(CUSTOMERS_INDEX_TAB);
  const idxValues = idx.getDataRange().getValues();

  const target = String(customerEmail).trim().toLowerCase();
  for (let i = 1; i < idxValues.length; i++) {
    if (String(idxValues[i][0]).trim().toLowerCase() === target) {
      return String(idxValues[i][1]).trim();
    }
  }

  let baseName = sanitizeSheetName(customerName || 'Customer');
  if (!baseName) baseName = 'Customer';

  let sheetName = baseName;
  let counter = 1;
  while (shopSs.getSheetByName(sheetName)) {
    counter++;
    sheetName = (baseName.substring(0, 25) + '_' + counter).substring(0, 31);
  }

  const sh = shopSs.insertSheet(sheetName);
  sh.appendRow([
    'Order ID', 'Shop Email', 'Items', 'Total',
    'Address', 'Transaction ID', 'Payment Screenshot',
    'Status', 'Note', 'Order Time', 'Updated Time',
    'Ratings Json', 'Rating Time'
  ]);

  idx.appendRow([customerEmail, sheetName, customerName || '', new Date()]);
  return sheetName;
}

